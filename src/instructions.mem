// instructions.mem - Programa de prueba TEA-ISA

// addi r1, r0, 5
// I-type: opcode=0001 rd=0001 rs1=0000 imm=00000000101

088005

// addi r2, r0, 10
// I-type: opcode=0001 rd=0010 rs1=0000 imm=00000001010
// 0001_0010_0000_000_0000_1010 = 0x09000A

09000A

// add r3, r1, r2
// R-type: opcode=0000 rd=0011 rs1=0001 rs2=0010 funct=000 res=0000
// 0000_0011_0001_0010_000_0000 = 0x031200

031200

// store r3, 0(r2)
// S-type: opcode=0100 rs2=0011 rs1=0010 offset=00000000000
// 0100_0011_0010_000_0000_0000 = 0x219000

219000

// load r4, 0(r2)
// I-type: opcode=0011 rd=0100 rs1=0010 offset=00000000000
// 0011_0100_0010_000_0000_0000 = 0x1A2000

1A2000

// beq r1, r2, +2
// B-type: opcode=0101 rs1=0001 rs2=0010 offset[10]=0 offset[9:0]=0000000010
// 0101_0001_0010_000_0000_0010 = 0x288002

288002

// nop
// JR-like: opcode=1001 res[14:13]=00
// 1001_0000_0000_000_0000_0000 = 0x480000

480000

// halt
// JR-like: opcode=1001 res[14:13]=01
// 1001_0000_0010_000_0000_0000 = 0x482000

482000
